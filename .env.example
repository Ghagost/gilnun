# 길눈 2.0 환경 변수 — Vercel: Project → Settings → Environment Variables 에 넣으세요.
# 아무것도 넣지 않아도 앱은 열려요 (무료 지도 + 사용자가 설정에서 자기 AI 키를 넣는 방식).

# ── AI (서버 키: 모든 사용자가 이 키로 AI를 씀 → 아래 ACCESS_CODE와 같이 쓰는 걸 권장) ──
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# 설정하면 서버 키를 쓰려면 앱 설정에 이 코드를 넣어야 해요 (사용자 자기 키는 코드 없이 사용 가능)
ACCESS_CODE=
# 서버 키로 쓸 수 있는 모델을 제한 (쉼표로 구분, 비우면 제한 없음)
AI_ALLOWED_MODELS=
# 실시간 대화 모델 (서버 키 사용 시 이 모델만 사용)
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
GEMINI_LIVE_MODEL=gemini-3.8-live

# ── Google Maps Platform ──
# 브라우저용 키: Maps JavaScript API, Places API (New), Routes API 사용 설정 + HTTP 리퍼러 제한(내 도메인)
GOOGLE_MAPS_API_KEY=
# 지도 ID (Cloud 콘솔 → 지도 관리 → JavaScript, 벡터). 비우면 DEMO_MAP_ID 사용
GOOGLE_MAPS_MAP_ID=
# 서버용 키: Maps Grounding Lite(MCP) 전용으로 API 제한. 넣으면 AI 장소 추천이 구글 지도 데이터로 나와요
GOOGLE_MAPS_SERVER_KEY=
# MAPS_GROUNDING_URL=https://mapstools.googleapis.com/mcp

# ── 일본 열차 실시간 경로 (NAVITIME Route(totalnavi) on RapidAPI) ──
RAPIDAPI_KEY=
# NAVITIME_BASE_URL=https://navitime-route-totalnavi.p.rapidapi.com

# ── 사용량 제한 저장소 (Upstash Redis / Vercel KV). 없으면 서버 메모리로 대충 제한 ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── 사용량 제한 (서버 키 사용분만 적용, 기기·IP 기준) ──
RATE_LIMIT_PER_MIN=20
RATE_LIMIT_PER_DAY=400
RATE_LIMIT_IP_PER_MIN=60
RATE_LIMIT_IP_PER_DAY=1500
RATE_LIMIT_LIVE_PER_HOUR=30
AI_MAX_OUTPUT_TOKENS=8000
